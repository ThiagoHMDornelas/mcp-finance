# OpenAI (obrigatorio para o agente)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Transporte do agente ate o servidor MCP: stdio (padrao) ou http
MCP_TRANSPORT=stdio

# Usados quando MCP_TRANSPORT=http
# MCP_SERVER_URL=http://localhost:8001/mcp

# Usados quando MCP_TRANSPORT=stdio (opcionais)
# MCP_SERVER_PATH=../server/main.py
# MCP_SERVER_COMMAND=            # padrao: o mesmo interpretador do agente (sys.executable)
